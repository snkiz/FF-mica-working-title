/* ==========================================================================
   NEW TAB / HOME – Gruvbox Dark (dark mode only)
   ========================================================================== */


@-moz-document url-prefix("about:newtab"), url-prefix("about:home") {
  @media (prefers-color-scheme: dark) {
    :root {
      --newtab-background-color: #282828 !important;
      --newtab-text-primary-color: #FFFFFF !important;
    }
  }
}


/* ==========================================================================
   PALETTE – Gruvbox Dark / Gruvbox Light
   userContent has no shared config with userChrome; keep in sync with the
   CONFIG block there. A retheme that only touches userChrome leaves every
   about: page and the new tab page in Gruvbox (issue #50), so change these
   values as well. Dark set first, the light scheme swaps in Gruvbox
   Light (issue #19). Top level instead of inside one @-moz-document block,
   because the pdf.js viewer can't be matched by URL and reads it too.
   ========================================================================== */

:root {
  --uc-color-base:    #282828;
  --uc-color-surface: #3c3836;
  --uc-color-accent:  #fabd2f;
  --uc-color-text:    #FFFFFF;
  --uc-color-hover:   #7c6f64;
  --uc-color-border:  #504945;   /* Gruvbox bg2, neutral control hairline */
  --uc-tab-hover-text: #ffda85;   /* tab title hover, between text and accent */
}
@media (prefers-color-scheme: light) {
  :root {
    --uc-color-base:    #fbf1c7;
    --uc-color-surface: #ebdbb2;
    --uc-color-accent:  #b57614;
    --uc-color-text:    #3c3836;
    --uc-color-hover:   #bdae93;
    --uc-color-border:  #d5c4a1;
    --uc-tab-hover-text: #855d22;
  }
}

